{
  "name": "fpomg",
  "version": "0.0.0",
  "description": "FPOMG: the URL-based custom FPO image API",
  "workspaces": [
    "apps/worker",
    "apps/frontend"
  ],
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "scripts": {
    "build": "npm run build -w=apps/frontend",
    "dev": "npm run build && npm run dev -w=apps/worker",
    "deploy": "npm run build && npm run deploy -w=apps/worker",
    "test": "npm run build && npm test -w=apps/worker"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrewrubin/fpomg.git"
  },
  "author": "Andrew Rubin <arubin78@gmail.com>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/andrewrubin/fpomg/issues"
  },
  "homepage": "https://github.com/andrewrubin/fpomg#readme"
}
